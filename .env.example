# .env.example — Copiez ce fichier en .env et remplissez les valeurs
# Le fichier .env ne doit JAMAIS être commité (voir .gitignore)

PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=invoice_pe

# Rôle propriétaire des schémas (créé par sql/init.sql)
PG_LOADER_USER=invoice_loader
PG_LOADER_PASSWORD=changeme_loader

# Rôle lecture seule (créé par sql/init.sql)
PG_READONLY_USER=bi_readonly
PG_READONLY_PASSWORD=changeme_readonly
